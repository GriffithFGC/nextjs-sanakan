# Copy to /etc/sf6-gateway.env, then: sudo chown root:sf6 /etc/sf6-gateway.env && sudo chmod 640 /etc/sf6-gateway.env

# Forgejo as reached from this machine
SF6_FORGEJO_URL=http://127.0.0.1:3000
# Token of the read-only bot account, scope read:repository only
SF6_FORGEJO_TOKEN=
# owner/name of the repository to publish
SF6_REPO=femto/sf6-learn
# Branch to publish (default: the repository's default branch)
#SF6_REF=main

# Pages allowed to call the gateway (GitHub Pages domain, Vercel domain, local dev)
SF6_ALLOWED_ORIGINS=https://leoazzopardi.org,https://nextjs-sanakan.vercel.app,http://localhost:3000

# Local port that tailscale serve/funnel points at
SF6_LISTEN=127.0.0.1:8787

# Extra names to hide (dot-files and dot-folders such as .obsidian are always hidden)
#SF6_EXCLUDE=Brouillons,Privé
# Palette written by 43pr (target [web]), served without a key at /v1/theme
#SF6_THEME_FILE=/srv/43pr/web-theme.json
# Lifetime of signed media links, in seconds (default 6 h)
#SF6_MEDIA_TTL=21600
